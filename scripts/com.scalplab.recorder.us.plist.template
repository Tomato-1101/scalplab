<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  scalp-lab 米国株ティック録画の launchd テンプレート。
  __ABSOLUTE_PATH__ は scripts/install_launchd.sh がプロジェクト実パスに置換する
  （リポジトリに絶対パスをコミットしないため）。
  平日 JST 22:20 に起動する（夏時間の NY 09:30 = JST 22:30 の約10分前。recorder が寄り付き待機する）。
  冬時間（NY 09:30 = JST 23:30）でも 22:20 起動→寄り付きまで待機で問題ない。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.scalplab.recorder.us</string>

    <key>ProgramArguments</key>
    <array>
        <string>__ABSOLUTE_PATH__/.venv/bin/python</string>
        <string>-m</string>
        <string>scalplab.record</string>
        <string>--market</string>
        <string>US</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__ABSOLUTE_PATH__</string>

    <!-- 平日（月=1 〜 金=5）JST 22:20 に起動。recorder 側が NY 寄り付き（夏 22:30/冬 23:30）まで待機する。 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>20</integer></dict>
    </array>

    <!-- 起動は StartCalendarInterval のみ。ロード時の即時起動はしない。 -->
    <key>RunAtLoad</key>
    <false/>

    <!-- 場中にクラッシュ（非ゼロ終了）したら自動再起動する。正常終了（NY 16:05 finalize 後や
         引け後起動ガードの exit 0）では再起動しない。再開時は live CSV へ追記され、
         finalize の seq 重複排除で継ぎ目なくマージされる。 -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>__ABSOLUTE_PATH__/logs/launchd-recorder-us.out.log</string>
    <key>StandardErrorPath</key>
    <string>__ABSOLUTE_PATH__/logs/launchd-recorder-us.err.log</string>
</dict>
</plist>
